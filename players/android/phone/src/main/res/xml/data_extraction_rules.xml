<?xml version="1.0" encoding="utf-8"?>
<!-- The device token is this device's own: it isn't backed up or moved to another. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
