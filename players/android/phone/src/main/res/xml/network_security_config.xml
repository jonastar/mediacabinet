<?xml version="1.0" encoding="utf-8"?>
<!--
  People's servers are often on a home network over plain HTTP, or behind HTTPS
  with their own certificate authority, so both are allowed.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
